{
	"title": "HSN Summary View",
	"frames":{
		"fy_select":{
			"widgets":[
				{
					"class": "Label",
					"text" : "Choose FY",
					"grid" : {"row":0, "column":0, "sticky":"w", "padx":10}
				},
				{
					"class" :"Separator",
					"orient":"vertical",
					"grid" : {"row":0, "column":1, "rowspan":10, "padx":10, "sticky":"nsw"}
				}
			],
			"grid" : {"row":1, "column":0, "rowspan":5, "sticky":"nsew", "padx":10}
		},
		"controls_1":{
			"widgets":[
				{
					"class":"Button",
					"text" :"Export List",
					"command": "on_export",
					"command_kwargs":{},
					"grid":{"row":0, "column":0, "padx":1, "pady":10}
				},
				{
					"class":"Button",
					"text" :"Refresh",
					"command": "toogle_fy",
					"command_kwargs":{},
					"grid":{"row":0, "column":1, "padx":1, "pady":10}
				},
				{
					"class":"Button",
					"text" :"Close",
					"command": "on_close",
					"command_kwargs":{},
					"grid":{"row":0, "column":2, "padx":1, "pady":10}
				}
			],
			"grid":{"row":3, "column":2, "sticky":"e"}
		}
	},
	"custom_frames":{
		"create_treeview" : {
			"class" : "create_treeview",
			"from_sql" : false,
			"columns" : ["BILL", "INVOICE_DATE", "ALIAS", "HSN_CODE", "GST", "TAXABLE"],
			"widths" : {"BILL" : 4, "INVOICE_DATE":10, "ALIAS":60, "HSN_CODE":60, "GST": 60, "TAXABLE":100},
			"grid":{"row":2, "column":2, "columnspan":3, "sticky":"nsew"}
		}
	}
}
